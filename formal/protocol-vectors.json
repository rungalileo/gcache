  "normalizeArgsVectors": [
    {
      "name": "sort and omit undefined",
      "input": {
        "z": "last",
        "missing": "__UNDEFINED__",
        "a": 1,
        "nil": null,
        "flag": false
      },
      "undefinedSentinel": "__UNDEFINED__",
      "expected": [
        [
          "a",
          "1"
        ],
        [
          "flag",
          "false"
        ],
        [
          "nil",
          "null"
        ],
        [
          "z",
          "last"
        ]
      ]
    },
    {
      "name": "scalar string normalization",
      "input": {
        "negativeZero": 0,
        "number": 1,
        "text": "1"
      },
      "expected": [
        [
          "negativeZero",
          "0"
        ],
        [
          "number",
          "1"
        ],
        [
          "text",
          "1"
        ]
      ]
    },
    {
      "name": "UTF-16 ordering including supplementary characters",
      "input": {
        "": "BMP",
        "😀": "supplementary",
        "A": 1,
        "a": 2,
        "é": 3
      },
      "expected": [
        [
          "A",
          "1"
        ],
        [
          "a",
          "2"
        ],
        [
          "é",
          "3"
        ],
        [
          "😀",
          "supplementary"
        ],
        [
          "",
          "BMP"
        ]
      ]
    },
    {
      "name": "number formatting boundaries",
      "input": {
        "small": 0.000001,
        "tiny": 1e-7,
        "large": 1e+21,
        "integer": 9007199254740991,
        "fraction": 1.25
      },
      "expected": [
        [
          "fraction",
          "1.25"
        ],
        [
          "integer",
          "9007199254740991"
        ],
        [
          "large",
          "1e+21"
        ],
        [
          "small",
          "0.000001"
        ],
        [
          "tiny",
          "1e-7"
        ]
      ]
    },
    {
