{
  "schemaVersion": 2,
  "vectors": [
    {
      "name": "absent marker gets the two hour floor",
      "existing": {
        "kind": "absent",
        "ttlMs": -2
      },
      "futureBufferMs": "0",
      "invalidatedAtMs": "1000",
      "expected": {
        "state": {
          "kind": "string",
          "value": "1000",
          "ttlMs": 7200000
        }
      }
    },
    {
      "name": "buffer determines marker cutoff",
      "existing": {
        "kind": "absent",
        "ttlMs": -2
      },
      "futureBufferMs": "200",
      "invalidatedAtMs": "1000",
      "expected": {
        "state": {
          "kind": "string",
          "value": "1200",
          "ttlMs": 7200000
        }
      }
    },
    {
      "name": "large buffer extends retention beyond the floor",
      "existing": {
        "kind": "absent",
        "ttlMs": -2
      },
      "futureBufferMs": "4000000",
      "invalidatedAtMs": "1000",
      "expected": {
        "state": {
          "kind": "string",
          "value": "4001000",
          "ttlMs": 7660000
        }
      }
    },
    {
      "name": "existing future cutoff never moves backwards",
      "existing": {
        "kind": "string",
        "value": "10000000",
        "ttlMs": 100
      },
      "futureBufferMs": "0",
      "invalidatedAtMs": "1000",
      "expected": {
        "state": {
          "kind": "string",
          "value": "10000000",
          "ttlMs": 13659000
        }
      }
    },
    {
      "name": "existing longer TTL never shrinks",
